{
  "version": 1,
  "defaultPolicy": "deny",
  "roles": {
    "admin": {
      "permissions": [
        "admin:read",
        "admin:write",
        "studio:use",
        "creator:use",
        "marketplace:read",
        "deliveries:read",
        "jobs:create",
        "jobs:read",
        "jobs:publish"
      ]
    },
    "studio": {
      "permissions": [
        "studio:use",
        "creator:use",
        "marketplace:read",
        "deliveries:read",
        "jobs:create",
        "jobs:read",
        "jobs:publish"
      ]
    },
    "creator": {
